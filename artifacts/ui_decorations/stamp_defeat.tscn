[gd_scene load_steps=4 format=3]

[sub_resource type="GDScript" id="GDScript_stamp"]
script/source = "extends Control
# 败阵印章 · 戏台战报风
@export var stamp_title := \"未竟\":
	set(v):
		stamp_title = v
		if is_node_ready():
			_refresh_text()
@export var stamp_sub := \"此劫未竟\":
	set(v):
		stamp_sub = v
		if is_node_ready():
			_refresh_text()

func _ready():
	custom_minimum_size = Vector2(120, 120)
	_draw_seal()
	_refresh_text()

func _refresh_text():
	if has_node(\"TitleLabel\"):
		$\"TitleLabel\".text = stamp_title
	if has_node(\"SubLabel\"):
		$\"SubLabel\".text = stamp_sub

func _draw_seal():
	var cx = 60.0
	var cy = 60.0

	# 外圈深墨褐印章轮廓（略扁，庄重感）
	var outer_pts = []
	var rx = 52.0
	var ry = 48.0
	for i in range(36):
		var angle = TAU * i / 36.0
		var wave = sin(angle * 5.0) * 0.03
		var r = rx * (1.0 + wave)
		var r2 = ry * (1.0 + wave)
		outer_pts.append(Vector2(cx + cos(angle) * r, cy + sin(angle) * r2))

	var outer = Polygon2D.new()
	outer.name = \"OuterPoly\"
	outer.polygon = PackedVector2Array(outer_pts)
	outer.color = Color(0.22, 0.14, 0.10, 0.88)  # 深墨褐
	outer.z_index = 0
	add_child(outer)

	# 内圈灰金边框
	var inner = Polygon2D.new()
	inner.name = \"InnerPoly\"
	var ir = 38.0
	var pts = [
		Vector2(cx - ir, cy - ir * 0.85),
		Vector2(cx + ir, cy - ir * 0.85),
		Vector2(cx + ir, cy + ir * 0.85),
		Vector2(cx - ir, cy + ir * 0.85)
	]
	inner.polygon = PackedVector2Array(pts)
	inner.color = Color(0.6, 0.55, 0.45, 0.12)
	inner.outline_color = Color(0.6, 0.55, 0.45, 0.75)
	inner.outline_size = 2
	inner.z_index = 1
	add_child(inner)

	# 四角小方块
	var dot_offsets = [
		Vector2(cx - ir - 2, cy - ir * 0.85 - 2),
		Vector2(cx + ir + 2, cy - ir * 0.85 - 2),
		Vector2(cx + ir + 2, cy + ir * 0.85 + 2),
		Vector2(cx - ir - 2, cy + ir * 0.85 + 2)
	]
	for i in range(4):
		var dot = Polygon2D.new()
		dot.name = \"CornerDot%d\" % i
		dot.polygon = PackedVector2Array([Vector2(-3,-3), Vector2(3,-3), Vector2(3,3), Vector2(-3,3)])
		dot.color = Color(0.6, 0.55, 0.45, 0.75)
		dot.position = dot_offsets[i]
		dot.z_index = 2
		add_child(dot)

	# 标题
	var title_lbl = Label.new()
	title_lbl.name = \"TitleLabel\"
	title_lbl.text = stamp_title
	title_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	title_lbl.position = Vector2(cx - 36, cy - 20)
	title_lbl.size = Vector2(72, 28)
	title_lbl.add_theme_color_override(\"font_color\", Color(0.22, 0.14, 0.10, 1.0))
	title_lbl.add_theme_font_size_override(\"font_size\", 18)
	title_lbl.z_index = 3
	add_child(title_lbl)

	# 副标题
	var sub_lbl = Label.new()
	sub_lbl.name = \"SubLabel\"
	sub_lbl.text = stamp_sub
	sub_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	sub_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	sub_lbl.position = Vector2(cx - 36, cy + 8)
	sub_lbl.size = Vector2(72, 20)
	sub_lbl.add_theme_color_override(\"font_color\", Color(0.45, 0.38, 0.32, 0.90))
	sub_lbl.add_theme_font_size_override(\"font_size\", 11)
	sub_lbl.z_index = 3
	add_child(sub_lbl)

	# 中心菱形装饰
	var diamond = Polygon2D.new()
	diamond.name = \"CenterDiamond\"
	var dm_pts = [Vector2(0,-8), Vector2(5,0), Vector2(0,8), Vector2(-5,0)]
	diamond.polygon = PackedVector2Array(dm_pts)
	diamond.color = Color(0.45, 0.38, 0.32, 0.60)
	diamond.position = Vector2(cx, cy)
	diamond.z_index = 2
	add_child(diamond)
"

[node name="StampDefeat" type="Control"]
layout_mode = 3
anchors_preset = 0
script = SubResource("GDScript_stamp")
