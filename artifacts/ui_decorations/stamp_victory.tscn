[gd_scene load_steps=4 format=3]

[sub_resource type="GDScript" id="GDScript_stamp"]
script/source = "extends Control
# 胜利印章 · 戏台战报风
# 实例化后在外部设置 stamp_title / stamp_sub
# 用法：实例化 → stamp_title = \"凯旋\" → call_deferred(\"_refresh\")
@export var stamp_title := \"凯旋\":
	set(v):
		stamp_title = v
		if is_node_ready():
			_refresh_text()
@export var stamp_sub := \"大圣护场\":
	set(v):
		stamp_sub = v
		if is_node_ready():
			_refresh_text()

func _ready():
	custom_minimum_size = Vector2(120, 120)
	_draw_seal()
	_refresh_text()

func _refresh_text():
	if has_node(\"TitleLabel\"):
		$\"TitleLabel\".text = stamp_title
	if has_node(\"SubLabel\"):
		$\"SubLabel\".text = stamp_sub

func _draw_seal():
	# 外圈朱砂印章轮廓（不规则椭圆形，手工感）
	var outer_pts = []
	var cx = 60.0
	var cy = 60.0
	var rx = 54.0
	var ry = 50.0
	for i in range(36):
		var angle = TAU * i / 36.0
		var wave = sin(angle * 6.0) * 0.035 + sin(angle * 3.0) * 0.025
		var r = rx * (1.0 + wave)
		var r2 = ry * (1.0 + wave)
		outer_pts.append(Vector2(cx + cos(angle) * r, cy + sin(angle) * r2))

	var outer = Polygon2D.new()
	outer.name = \"OuterPoly\"
	outer.polygon = PackedVector2Array(outer_pts)
	outer.color = Color(0.80, 0.16, 0.12, 0.90)  # 朱砂红
	outer.z_index = 0
	add_child(outer)

	# 内圈暖金边框
	var inner = Polygon2D.new()
	inner.name = \"InnerPoly\"
	var ir = 40.0
	var pts = [
		Vector2(cx - ir, cy - ir * 0.85),
		Vector2(cx + ir, cy - ir * 0.85),
		Vector2(cx + ir, cy + ir * 0.85),
		Vector2(cx - ir, cy + ir * 0.85)
	]
	inner.polygon = PackedVector2Array(pts)
	inner.color = Color(0.94, 0.82, 0.55, 0.12)
	inner.outline_color = Color(0.94, 0.82, 0.55, 0.80)
	inner.outline_size = 2
	inner.z_index = 1
	add_child(inner)

	# 四角铜钉
	var dot_offsets = [
		Vector2(cx - ir - 2, cy - ir * 0.85 - 2),
		Vector2(cx + ir + 2, cy - ir * 0.85 - 2),
		Vector2(cx + ir + 2, cy + ir * 0.85 + 2),
		Vector2(cx - ir - 2, cy + ir * 0.85 + 2)
	]
	for i in range(4):
		var dot = Polygon2D.new()
		dot.name = \"CornerDot%d\" % i
		dot.polygon = PackedVector2Array([Vector2(-4,-4), Vector2(4,-4), Vector2(4,4), Vector2(-4,4)])
		dot.color = Color(0.94, 0.82, 0.55, 0.85)
		dot.position = dot_offsets[i]
		dot.z_index = 2
		add_child(dot)

	# 标题标签（印章主体文字）
	var title_lbl = Label.new()
	title_lbl.name = \"TitleLabel\"
	title_lbl.text = stamp_title
	title_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	title_lbl.position = Vector2(cx - 36, cy - 20)
	title_lbl.size = Vector2(72, 28)
	title_lbl.add_theme_color_override(\"font_color\", Color(0.80, 0.16, 0.12, 1.0))
	title_lbl.add_theme_font_size_override(\"font_size\", 18)
	title_lbl.z_index = 3
	add_child(title_lbl)

	# 副标题（印章底部小字）
	var sub_lbl = Label.new()
	sub_lbl.name = \"SubLabel\"
	sub_lbl.text = stamp_sub
	sub_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	sub_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	sub_lbl.position = Vector2(cx - 36, cy + 8)
	sub_lbl.size = Vector2(72, 20)
	sub_lbl.add_theme_color_override(\"font_color\", Color(0.94, 0.82, 0.55, 0.90))
	sub_lbl.add_theme_font_size_override(\"font_size\", 11)
	sub_lbl.z_index = 3
	add_child(sub_lbl)

	# 中心小星纹装饰
	var star = Polygon2D.new()
	star.name = \"CenterStar\"
	var star_pts = []
	for i in range(8):
		var a = TAU * i / 8.0
		var r = 6.0 if i % 2 == 0 else 3.0
		star_pts.append(Vector2(cx + cos(a) * r, cy + sin(a) * r))
	star.polygon = PackedVector2Array(star_pts)
	star.color = Color(0.94, 0.82, 0.55, 0.70)
	star.z_index = 2
	add_child(star)
"

[node name="StampVictory" type="Control"]
layout_mode = 3
anchors_preset = 0
script = SubResource("GDScript_stamp")
